# ============================================================
# WatchStore – Environment Variables
# Copy to .env and fill real values. NEVER commit .env
# ============================================================

# Django
SECRET_KEY=change-this-to-a-long-random-secret-key-min-50-chars
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# Database (MySQL)
DB_NAME=watchstore_db
DB_USER=watchstore
DB_PASSWORD=strong_random_db_password_here
DB_HOST=db
DB_PORT=3306

# Backend base URL (used for payment callbacks & emails)
BASE_URL=https://api.yourdomain.com

# CORS (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False

# SSLCommerz (set SSL_SANDBOX=False for live)
STORE_ID=your_store_id
STORE_PASSWORD=your_store_password
SSL_SANDBOX=False

# Email (Gmail App Password recommended)
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# Optional: JWT
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7